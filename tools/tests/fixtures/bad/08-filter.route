-- Test fixture with made-up quest IDs. Prepared error (filter): human-only quest without race filter.
#module t-speed-start-elwynn
#kind start
#faction Alliance
#mode speed
#levels 1-10
#label vorläufig
#version 1
#sources polestar=test eglink=test
#text Prüfroute Wald von Elwynn

