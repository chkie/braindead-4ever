<Bindings>
	<!-- SPDX-License-Identifier: GPL-3.0-or-later WITH AdditionRef-Braindead4Ever-Ace3-Exception -->
	<!-- Key bindings (concept §2.7, design rule B5): unbound by default, so no binding of the player is
	     overwritten. The client loads this file by itself, it is not in the TOC. Names: UI/Bindings.lua. -->
	<Binding name="BRAINDEADFOREVER_TOGGLE" category="BINDING_HEADER_BRAINDEADFOREVER">
		BraindeadForeverBinding("TOGGLE")
	</Binding>
	<Binding name="BRAINDEADFOREVER_CHECK" category="BINDING_HEADER_BRAINDEADFOREVER">
		BraindeadForeverBinding("CHECK")
	</Binding>
	<Binding name="BRAINDEADFOREVER_SKIP" category="BINDING_HEADER_BRAINDEADFOREVER">
		BraindeadForeverBinding("SKIP")
	</Binding>
	<Binding name="BRAINDEADFOREVER_BACK" category="BINDING_HEADER_BRAINDEADFOREVER">
		BraindeadForeverBinding("BACK")
	</Binding>
	<Binding name="BRAINDEADFOREVER_WINDOW" category="BINDING_HEADER_BRAINDEADFOREVER">
		BraindeadForeverBinding("WINDOW")
	</Binding>
	<Binding name="BRAINDEADFOREVER_MINI" category="BINDING_HEADER_BRAINDEADFOREVER">
		BraindeadForeverBinding("MINI")
	</Binding>
	<Binding name="BRAINDEADFOREVER_STATS" category="BINDING_HEADER_BRAINDEADFOREVER">
		BraindeadForeverBinding("STATS")
	</Binding>
	<!-- Quest item button (M8, UI/QuestItem.lua): a click binding on the secure button, so the key uses the
	     item like a click; its name is set in UI/QuestItem.lua. -->
	<Binding name="CLICK BraindeadForeverQuestItemButton:LeftButton" category="BINDING_HEADER_BRAINDEADFOREVER">
	</Binding>
</Bindings>
