-- SPDX-License-Identifier: GPL-3.0-or-later
-- Luacheck for Braindead 4ever (pattern after BigWigs/Questie). WoW Lua is 5.1.
-- read_globals is the API inventory: list only what the addon really uses, and check each
-- new name against the Forever API dump before adding it.
std = "lua51"
max_line_length = false
codes = true
exclude_files = { ".tools/**", ".release/**", ".lua/**", ".luarocks/**", "types/**" }
ignore = {
	"212/self", -- unused self in methods
	"211/_.*", -- deliberately ignored locals with _ prefix
}
read_globals = {
	-- WoW API used by the addon
	-- namespaces list their used functions, so a misspelled field is W143
	C_AddOns = { fields = { "GetAddOnMetadata" } },
	C_ChatInfo = { fields = { "RegisterAddonMessagePrefix", "SendAddonMessage" } },
	C_EncodingUtil = {
		fields = { "CompressString", "DecodeBase64", "DecompressString", "DeserializeJSON", "EncodeBase64", "SerializeJSON" },
	},
	C_EventUtils = { fields = { "IsEventValid" } },
	C_Map = {
		fields = {
			"CanSetUserWaypointOnMap",
			"ClearUserWaypoint",
			"GetAreaInfo",
			"GetBestMapForUnit",
			"GetMapInfo",
			"GetMapPosFromWorldPos",
			"GetMapWorldSize",
			"GetPlayerMapPosition",
			"GetWorldPosFromMapPos",
			"SetUserWaypoint",
		},
	},
	C_QuestLog = {
		fields = {
			"GetInfo",
			"GetLogIndexForQuestID",
			"GetNumQuestLogEntries",
			"GetQuestObjectives",
			"GetTitleForQuestID",
			-- watch list (UI/QuestWatch.lua, QuestLogDocumentation.lua forever)
			"AddQuestWatch",
			"GetNumQuestWatches",
			"GetQuestIDForQuestWatchIndex",
			"RemoveQuestWatch",
			"IsComplete",
			"IsFailed",
			"IsQuestFlaggedCompleted",
			"RequestLoadQuestByID",
		},
	},
	C_Timer = { fields = { "After", "NewTicker" } },
	-- Enum and Constants: sub-tables listed, their values not (generated by the client)
	Enum = {
		fields = {
			AddOnProfilerMetric = { other_fields = true },
			AddOnRestrictionState = { other_fields = true },
			AddOnRestrictionType = { other_fields = true },
			Base64Variant = { other_fields = true },
			CompressionLevel = { other_fields = true },
			CompressionMethod = { other_fields = true },
			FlightPathState = { other_fields = true },
			InputDeviceInterfaceType = { other_fields = true }, -- Welle 9: gamepad UI (InputConstants, forever)
			RegisterAddonMessagePrefixResult = { other_fields = true },
			SendAddonMessageResult = { other_fields = true },
		},
	},
	Constants = { fields = { LegacyConsts = { other_fields = true }, QuestWatchConsts = { other_fields = true } } },
	-- interface (UI/, Welle 5): checked against the Forever inventories (Ketho BlizzardInterfaceResources
	-- branch forever: GlobalAPI, FrameXML, Frames, Mixins, GlobalStrings; wow-ui-source forever)
	C_CVar = { fields = { "GetCVar" } },
	C_Item = { fields = { "GetItemNameByID" } },
	-- M4: NPC names from the creature cache (TooltipInfoDocumentation.lua forever, Ketho forever d1ee569)
	C_TooltipInfo = { fields = { "GetHyperlink" } },
	C_Minimap = { fields = { "GetViewRadius" } },
	C_SuperTrack = { fields = { "SetSuperTrackedUserWaypoint" } },
	C_Texture = { fields = { "GetAtlasInfo" } },
	-- Welle 5b: Blizzard's quest tracker, only its alpha (Blizzard_ObjectiveTracker.xml forever)
	ObjectiveTrackerFrame = { fields = { "GetAlpha", "SetAlpha" } },
	-- Welle 5b: scroll list of the step window (wow-ui-source forever Shared/Scroll)
	ScrollUtil = { fields = { "InitScrollBoxWithScrollBar" } },
	ScrollBoxConstants = { fields = { "UpdateImmediately" } },
	AddonCompartmentFrame = { fields = { "RegisterAddon" } },
	EventRegistry = { fields = { "RegisterCallback" } },
	GameTooltip = {
		fields = { "AddLine", "Hide", "SetHyperlink", "SetOwner", "SetQuestLogSpecialItem", "SetText", "Show" },
	},
	HelpTip = { fields = { "ButtonStyle", "Hide", "IsShowing", "Point", "Show" } },
	MenuUtil = { fields = { "CreateContextMenu" } },
	MinimalSliderWithSteppersMixin = { fields = { Label = { other_fields = true } } },
	Settings = {
		fields = {
			"CreateCheckbox",
			"CreateControlTextContainer",
			"CreateDropdown",
			"CreateSlider",
			"CreateSliderOptions",
			"OpenToCategory",
			"RegisterAddOnCategory",
			"RegisterAddOnSetting",
			"RegisterCanvasLayoutSubcategory",
			"RegisterVerticalLayoutCategory",
			"RegisterVerticalLayoutSubcategory",
			VarType = { other_fields = true },
		},
	},
	StaticPopupDialogs = { fields = { BRAINDEADFOREVER_SKIP_CHAIN = { read_only = false, other_fields = true } } },
	-- optional automation (UI/Auto.lua, A74); checked against Ketho GlobalAPI forever d1ee569 and
	-- Gethe forever 17ed2c3 (1.60.1 70755)
	C_GossipInfo = { fields = { "GetActiveQuests", "GetAvailableQuests", "SelectActiveQuest", "SelectAvailableQuest" } },
	UIErrorsFrame = { fields = { "AddMessage" } },
	UiMapPoint = { fields = { "CreateFromCoordinates" } },
	WorldMapFrame = {
		fields = {
			"AddDataProvider",
			"GetCanvas",
			pinPools = { read_only = false, other_fields = true },
		},
	},
	"AbbreviateNumbers",
	"BreakUpLargeNumbers",
	"CreateFont",
	"CreateFramePool",
	"CreateFromMixins",
	"CreateSettingsButtonInitializer",
	"CreateScrollBoxLinearView",
	"CreateSettingsListSectionHeaderInitializer",
	"CreateUnsecuredRegionPoolInstance",
	"CreateVector2D",
	"GetCursorPosition",
	"GetPlayerFacing",
	"IsShiftKeyDown", -- Welle 5c: the arrow moves with Shift held (owner reading 16)
	-- quest dialog, optional automation (UI/Auto.lua, A74), all in Ketho GlobalAPI forever d1ee569
	"AcceptQuest",
	"AcknowledgeAutoAcceptQuest",
	"CompleteQuest",
	"GetActiveQuestID",
	"GetActiveTitle",
	"GetAvailableQuestInfo",
	"GetNumActiveQuests",
	"GetNumAvailableQuests",
	"GetNumQuestChoices",
	"GetQuestID",
	"GetQuestMoneyToGet",
	"GetQuestReward",
	"IsQuestCompletable",
	"QuestFlagsPVP",
	"QuestGetAutoAccept",
	"QuestIsFromAreaTrigger",
	"SelectActiveQuest",
	"SelectAvailableQuest",
	"MapCanvasDataProviderMixin",
	"MapCanvasPinMixin",
	"Minimap",
	"Mixin",
	"PlaySound",
	"StaticPopup_ForEachShownDialog",
	"StaticPopup_Hide", -- Welle 5d: the developer preview closes the skip dialog of the state before
	"StaticPopup_Show",
	"UnitPosition",
	-- Welle 8: tabs of the page "Your run" (wow-ui-source forever Blizzard_SharedXML/Mainline/
	-- SharedUIPanelTemplates.lua) and the day of a best time (Lua's os.date, Ketho GlobalAPI forever "date")
	"PanelTemplates_SetNumTabs",
	"PanelTemplates_SetTab",
	"PanelTemplates_TabResize",
	"date",
	-- interface strings, colors and sounds (GlobalStrings, FrameXML constants)
	"CANCEL",
	"DIM_RED_FONT_COLOR",
	"HIGHLIGHT_FONT_COLOR",
	"HUD_EDIT_MODE_MENU",
	"IN_GAME_NAVIGATION_RANGE",
	"LFG_TYPE_DUNGEON",
	"NAVIGATION_DESTINATION_REACHED_MESSAGE",
	"NORMAL_FONT_COLOR",
	"OBJECTIVE_TRACKER_COLOR",
	"OPTIONAL",
	"SOUNDKIT",
	"XP",
	"CreateFrame",
	"GetBuildInfo",
	"GetLocale",
	"GetTime",
	-- units, player, group (collector, exchange, report)
	"GetChannelName",
	"GetFramerate",
	"GetNumGroupMembers",
	"GetServerTime",
	"GetUnitName",
	"GetXPExhaustion",
	"InCombatLockdown",
	"IsInGroup",
	"IsInGuild",
	"IsInInstance",
	"IsInRaid",
	"LE_PARTY_CATEGORY_INSTANCE",
	"UnitClass",
	"UnitClassification",
	"UnitFactionGroup",
	"UnitGUID",
	"UnitLevel",
	"UnitName",
	"UnitRace",
	"UnitXP",
	"UnitXPMax",
	-- loot, flight master, strings
	"ERR_NEWTAXIPATH",
	"GetLootSlotLink",
	"GetNumLootItems",
	"GetTaxiMapID",
	"hooksecurefunc", -- secure post-hook on TakeTaxiNode (in the Forever API dump, Ketho forever d1ee569)
	-- copy window and chat frames
	"CLOSE",
	"ChatFontNormal",
	"IsControlKeyDown",
	"IsMetaKeyDown",
	"NUM_CHAT_WINDOWS",
	"UIParent",
	"UISpecialFrames",
	"tinsert",
	-- developer probe only (Probe/, not packaged)
	"GetAddOnMemoryUsage",
	"GetInventoryItemID",
	"UpdateAddOnMemoryUsage",
	"debugprofilestop",
	-- M8 quest item button (Ketho GlobalAPI forever d1ee569; Blizzard_ObjectiveTrackerShared.lua and
	-- Blizzard_ActionBar/Shared/ActionButton.lua, wow-ui-source forever 17ed2c3)
	"ACTIONBAR_HOTKEY_FONT_COLOR",
	"CooldownFrame_Set",
	"GetBindingKey",
	"GetBindingText",
	"GetQuestLogSpecialItemCooldown",
	"GetQuestLogSpecialItemInfo",
	"IsQuestLogSpecialItemInRange",
	"RANGE_INDICATOR",
	"RED_FONT_COLOR",
	-- M4: placeholders the client shows while it has no name (GlobalStrings forever)
	"RETRIEVING_DATA",
	"UNKNOWN",
	"UNKNOWNOBJECT",
	-- error handling and secret values
	"debugstack",
	"geterrorhandler",
	"issecretvalue",
	-- flavor constants (WOW_PROJECT_CAMELOT exists only in Forever)
	"WOW_PROJECT_ID",
}
globals = {
	"BraindeadForeverDB", -- ## SavedVariables
	"BraindeadForeverCollectDB", -- ## SavedVariables (collector data)
	"BraindeadForeverCharDB", -- ## SavedVariablesPerCharacter (random character ID)
	"SLASH_BRAINDEADFOREVER1",
	"SLASH_BRAINDEADFOREVER2",
	"SLASH_BRAINDEADFOREVER3",
	"SlashCmdList",
	-- key bindings (Bindings.xml, UI/Bindings.lua): the handler and the names on Blizzard's binding page
	"BraindeadForeverBinding",
	"BINDING_HEADER_BRAINDEADFOREVER",
}
files["spec/**/*.lua"] = {
	std = "+busted",
	globals = { "_G", "C_EncodingUtil", "C_Map", "C_QuestLog" }, -- tests swap single stand-ins
	read_globals = { "Enum" },
}
