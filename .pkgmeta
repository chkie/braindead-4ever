# SPDX-License-Identifier: GPL-3.0-or-later
# BigWigsMods/packager. YAML: spaces only, no tabs. Dotfiles are always ignored.
# The addon lives in Pathmark/; move-folders lifts it to the package root.
package-as: Pathmark

move-folders:
  Pathmark/Pathmark: Pathmark

# Release notes in English and German, written by hand (CHANGELOG.md); without this key the packager
# would build them from the commit subjects.
manual-changelog:
  filename: CHANGELOG.md
  markup-type: markdown

ignore:
  - Pathmark/Probe
  - data
  - decoder
  - docs
  - scripts
  - spec
  - tools
  - types
  - CONTRIBUTING.md
  - README.md
  - stylua.toml
